{
  "name": "agent-relay-dsh",
  "version": "0.1.1",
  "description": "Agent Relay DSH host plugin",
  "type": "module",
  "scripts": {
    "prepack": "node ../../scripts/build-dsh-package.mjs"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills"
  ],
  "keywords": [
    "dsh",
    "plugin",
    "agent-relay"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-0"
  }
}
